# Paper Pulse - Server Configuration Environment Variables

# Node.js Server Port
PORT=5000

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/paper_pulse

# JSON Web Token Configuration (Secures client auth and user isolation)
# WARNING: Do not use default or predictable secrets in production!
JWT_SECRET=paper_pulse_jwt_secret_key_2026_antigravity
JWT_EXPIRES_IN=7d

# Initial balance allocated to new virtual paper-trading wallets
INITIAL_WALLET_BALANCE=100000

# Allowed origins for Cross-Origin Resource Sharing (CORS)
CORS_ORIGIN=*

# Path to python executable to run ML forecasts if process spawning is used
ML_PYTHON_PATH=python

# Base directory where trained ML models and serialized scalers are located
ML_MODEL_PATH=ml/models/trained
